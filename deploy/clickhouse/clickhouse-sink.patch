+package redact
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestSegmentedDetectionFindsSecretsAcrossBoundariesAndCaches(t *testing.T) {
+	r, err := New()
+	if err != nil {
+		t.Fatal(err)
+	}
+	token := "ghp_Zk3Q9mW2xV7pL4tR8nB1cH6jD5fG0sA2eY9u"
+	filler := strings.Repeat(`{"role":"user","content":"please run the tests and fix the failing assertion"},`, 3000)
+	// Secrets near every kind of position: start, middle, end, and right
+	// across each cut point of the filler.
+	text := token + " " + filler + " " + token + " " + filler + " " + token
+	cuts := segments(text)
+	if len(cuts) < 10 {
+		t.Fatalf("expected many segments, got %d", len(cuts))
+	}
+	for _, cut := range cuts[1 : len(cuts)-1] {
+		if cut > 20 && cut+20 < len(text) {
+			text = text[:cut-20] + token + text[cut-20:]
+			break
+		}
+	}
+	found := 0
+	for _, f := range r.detect(text) {
+		if f.secret == token {
+			found++
+		}
+	}
+	if found < 4 {
+		t.Fatalf("found the token %d times, want at least 4", found)
+	}
+
+	// A follow-up request that appends to the same history mostly hits the cache.
+	start := time.Now()
+	r.detect(text + filler[:5000])
+	if elapsed := time.Since(start); elapsed > time.Second {
+		t.Fatalf("re-scanning cached history took %v", elapsed)
+	}
+}
