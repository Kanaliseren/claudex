index 0000000..716f9a8
--- /dev/null
+++ b/plugins/clickhouse-sink/capture_limit_test.go
@@ -0,0 +1,29 @@
+package main
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestCaptureOverLimitKeepsMetadataOnly(t *testing.T) {
+	c := newCapture()
+	now := time.Now()
+	c.begin(interceptRequest{RequestID: "r1", Body: []byte("hello")}, now)
+	chunk := []byte(strings.Repeat("x", 1<<20))
+	for i := 0; i <= maxCaptureBytes>>20; i++ {
+		c.chunk(streamChunkRequest{RequestID: "r1", Body: chunk, ChunkIndex: i}, now)
+	}
+	row := c.complete(completion{RequestID: "r1", Model: "m"})
+	if row.RequestBody != "" || len(row.ResponseChunks) != 0 || !strings.Contains(row.Error, droppedNote) {
+		t.Fatalf("over-limit capture kept bodies: body=%d chunks=%d error=%q", len(row.RequestBody), len(row.ResponseChunks), row.Error)
+	}
+	if c.total != 0 {
+		t.Fatalf("pending bytes not released: %d", c.total)
+	}
+
+	c.begin(interceptRequest{RequestID: "r2", Body: []byte("small")}, now)
+	if row := c.complete(completion{RequestID: "r2"}); row.RequestBody != "small" || row.Error != "" {
+		t.Fatalf("small capture changed: %+v", row)
+	}
+}
diff --git a/plugins/clickhouse-sink/collector.go b/plugins/clickhouse-sink/collector.go
new file mode 100644
index 0000000..e95b43c
--- /dev/null
+++ b/plugins/clickhouse-sink/collector.go
@@ -0,0 +1,202 @@
+//go:build collector
+
+// Collector mode: the same capture, redaction and ClickHouse sink, run as its
+// own process instead of inside CLIProxyAPI. claudex-tap forwards the proxy's
+// hook payloads over a unix socket as <uint32 length><uint8 method length>
+// <method><payload> frames; a crash, stall or memory blow-up here cannot
+// affect the proxy.
+//
+// Build: go build -tags collector -o collector .
+package main
+
+import (
+	"bufio"
+	"encoding/binary"
+	"encoding/json"
+	"io"
+	"net"
+	"os"
+	"os/signal"
+	"runtime"
+	"strings"
+	"syscall"
+	"time"
+)
+
+// workers redact and store finished requests in parallel, so a large body
+// never stalls the socket reader (the tap drops events after 5 s of stall).
+var workers = make(chan struct{}, max(2, runtime.NumCPU()/2))
+
+// maxFrame bounds one event: the tap's 64 MiB payload limit plus the method.
+const maxFrame = 64<<20 + 512
+
+// accepted are the only methods a frame may name; anything else, including
+// plugin reconfiguration, is ignored.
+var accepted = map[string]bool{
+	"request.intercept_before":        true,
+	"response.intercept_after":        true,
+	"response.intercept_stream_chunk": true,
+	"request.complete":                true,
+	"usage.handle":                    true,
+	"tap.hello":                       true,
+	"tap.dropped":                     true,
+}
+
+func main() {
+	socket, configPath := os.Getenv("TAP_SOCKET"), os.Getenv("SINK_CONFIG")
+	raw, errRead := os.ReadFile(configPath)
+	if errRead != nil || socket == "" {
+		logf("TAP_SOCKET and a readable SINK_CONFIG are required")
+		os.Exit(2)
+	}
+	if errConfig := current.configure(raw); errConfig != nil {
+		logf("config: %v", errConfig)
+		os.Exit(2)
+	}
+	waitForSecrets()
+	_ = os.Remove(socket)
+	ln, errListen := net.Listen("unix", socket)
+	if errListen != nil {
+		logf("listen: %v", errListen)
+		os.Exit(1)
+	}
+	_ = os.Chmod(socket, 0o600)
+
+	stop := make(chan os.Signal, 1)
+	signal.Notify(stop, syscall.SIGTERM, os.Interrupt)
+	go func() {
+		<-stop
+		_ = ln.Close()
+	}()
+	for {
+		conn, errAccept := ln.Accept()
+		if errAccept != nil {
+			break
+		}
+		go serve(conn)
+	}
+	// Let in-flight workers finish, so their rows are flushed on shutdown.
+	for i := 0; i < cap(workers); i++ {
+		workers <- struct{}{}
+	}
+	current.shutdown()
+}
+
+func serve(conn net.Conn) {
+	defer func() { _ = conn.Close() }()
+	r := bufio.NewReaderSize(conn, 1<<20)
+	header := make([]byte, 4)
+	for {
+		if _, err := io.ReadFull(r, header); err != nil {
+			return
+		}
+		size := binary.BigEndian.Uint32(header)
+		if size == 0 || size > maxFrame {
+			logf("dropping connection: bad frame size %d", size)
+			return
+		}
+		frame := make([]byte, size)
+		if _, err := io.ReadFull(r, frame); err != nil {
+			return
+		}
+		m := int(frame[0])
+		if 1+m > len(frame) {
+			logf("dropping connection: bad frame")
+			return
+		}
+		handleFrame(string(frame[1:1+m]), frame[1+m:])
+	}
+}
+
+// waitForSecrets accepts no traffic until every secret source has been read,
+// so no row is redacted against a partial set (e.g. a credential file caught
+// mid-rewrite at startup). Until then the tap drops events.
+func waitForSecrets() {
+	r := current.currentRedactor()
+	if r == nil {
+		logf("secret redaction unavailable; not accepting traffic")
+		os.Exit(1)
+	}
+	for logged := false; ; time.Sleep(time.Second) {
+		failed := r.Failed()
+		if len(failed) == 0 {
+			return
+		}
+		if !logged {
+			logf("waiting for unreadable secret sources: %s", strings.Join(failed, ", "))
+			logged = true
+		}
+	}
+}
+
+func handleFrame(method string, payload []byte) {
+	defer func() {
+		if recover() != nil {
+			logf("%s: panic recovered", method)
+		}
+	}()
+	switch {
+	case !accepted[method]:
+		logf("ignoring unexpected method %q", method)
+		return
+	case method == "tap.hello":
+		logf("tap connected %s", payload)
+		return
+	case method == "tap.dropped":
+		// Some events of in-flight requests never arrived: mark them.
+		logf("tap dropped events %s", payload)
+		current.capture.markLost()
+		return
+	}
+	switch method {
+	case "request.complete":
+		// Closing the capture is cheap and keeps event order; redaction and
+		// the insert run on a worker.
+		var req completion
+		if err := json.Unmarshal(payload, &req); err != nil {
+			logf("%s: decode: %v", method, err)
+			return
+		}
+		row := current.capture.complete(req)
+		if row.Model == "" && row.RequestedModel == "" {
+			return // model listings and similar calls are not inference
+		}
+		offload(func() {
+			if s := current.currentSink(); s != nil {
+				redactRequest(current.currentRedactor(), &row)
+				s.add(tableRequests, row)
+			}
+		})
+		return
+	case "usage.handle":
+		var record usageRecord
+		if err := json.Unmarshal(payload, &record); err != nil {
+			logf("%s: decode: %v", method, err)
+			return
+		}
+		row := usageRowFrom(record, current.capture.storeBodies())
+		offload(func() {
+			if s := current.currentSink(); s != nil {
+				redactUsage(current.currentRedactor(), &row)
+				s.add(tableUsage, row)
+			}
+		})
+		return
+	}
+	if _, err := current.handle(method, payload); err != nil {
+		logf("%s: %v", method, err)
+	}
+}
+
+// offload runs fn on a worker, waiting for a free one; redactRequest and
+// redactUsage already fail closed on a panic.
+func offload(fn func()) {
+	workers <- struct{}{}
+	go func() {
+		defer func() {
+			_ = recover()
+			<-workers
+		}()
+		fn()
+	}()
+}
