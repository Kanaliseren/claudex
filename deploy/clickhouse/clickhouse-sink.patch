diff --git a/plugins/clickhouse-sink/deriver/context.go b/plugins/clickhouse-sink/deriver/context.go
new file mode 100644
index 0000000..aade33c
--- /dev/null
+++ b/plugins/clickhouse-sink/deriver/context.go
@@ -0,0 +1,416 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"strings"
+
+	"github.com/api-token/Cli-Proxy-API-Management-Center/plugins/clickhouse-sink/redact"
+)
+
+// The context ledger keeps what Claude Code sent besides the conversation:
+// every distinct tool definition and system prompt block, once, forever, and
+// per request the ordered hashes it offered. Raw bodies expire after a few
+// days; this is what lets a tool description or prompt edit be compared with
+// how the model used it later.
+
+const (
+	contextStatusOK              = "ok"
+	contextStatusNoBody          = "no_body"
+	contextStatusUnparseable     = "unparseable"
+	contextStatusRedactionFailed = "redaction_failed"
+
+	kindTool    = "tool"
+	kindSystem  = "system"
+	kindBilling = "billing"
+
+	// billingPrefix starts Claude Code's per-request billing system block,
+	// which changes on every request and is not part of the prompt.
+	billingPrefix = "x-anthropic-billing-header:"
+)
+
+// contextBlob is one row of context_blobs.
+type contextBlob struct {
+	Hash    string `json:"hash"`
+	Kind    string `json:"kind"`
+	Name    string `json:"name"`
+	Content string `json:"content"`
+}
+
+// contextRow is one row of request_context.
+type contextRow struct {
+	RequestID    string   `json:"request_id"`
+	StartedAt    string   `json:"started_at"`
+	IngestedAt   string   `json:"ingested_at"`
+	SessionID    string   `json:"session_id"`
+	AgentID      string   `json:"agent_id"`
+	ToolHashes   []string `json:"tool_hashes"`
+	SystemHashes []string `json:"system_hashes"`
+	Status       string   `json:"status"`
+}
+
+type contextCandidate struct {
+	RequestID  string `json:"request_id"`
+	StartedAt  string `json:"started_at"`
+	IngestedAt string `json:"ingested_at"`
+	Size       uint64 `json:"size"`
+	SessionID  string `json:"session_id"`
+	AgentID    string `json:"agent_id"`
+}
+
+// contextMemo maps the raw bytes of an item to its stored blob, so one pass
+// redacts each distinct definition once even though every request repeats it.
+type contextMemo map[[sha256.Size]byte]contextBlob
+
+// contextPass fills request_context for every /v1/messages row that has none
+// yet, at most maxBatches batches per call so the facts pass is never
+// starved. Like pass, it never moves past rows it failed to store.
+func (d *deriver) contextPass(ctx context.Context, maxBatches int) (int, error) {
+	lower, err := d.contextWatermark(ctx)
+	if err != nil {
+		return 0, fmt.Errorf("context watermark: %w", err)
+	}
+	var memo contextMemo
+	var memoLoads uint64
+	cursorTS, cursorID := lower, ""
+	total := 0
+	for i := 0; i < maxBatches; i++ {
+		// Every blob in a batch is redacted against one complete secret set:
+		// checked here, and again before anything is written.
+		loads, ok := d.secretSet()
+		if !ok {
+			return total, fmt.Errorf("secret sources unreadable, context pass skipped")
+		}
+		if memo == nil || loads != memoLoads {
+			memo, memoLoads = contextMemo{}, loads
+		}
+		cands, err := d.contextCandidates(ctx, lower, cursorTS, cursorID)
+		if err != nil {
+			return total, fmt.Errorf("context candidates: %w", err)
+		}
+		if len(cands) == 0 {
+			break
+		}
+		cands = capBytes(cands, d.contextByteCap)
+		bodies, err := d.contextBodies(ctx, lower, cands)
+		if err != nil {
+			return total, fmt.Errorf("context bodies: %w", err)
+		}
+		rows := make([]any, 0, len(cands))
+		var referenced []contextBlob
+		for _, c := range cands {
+			row, blobs := buildContext(d.redactor, memo, c, bodies[c.RequestID])
+			rows = append(rows, row)
+			referenced = append(referenced, blobs...)
+		}
+		// The set reloaded or failed mid-batch, so some blobs may have been
+		// redacted against a different or incomplete set: drop the batch and
+		// retry it next loop.
+		if after, ok := d.secretSet(); !ok || after != loads {
+			return total, fmt.Errorf("secret set changed during a context batch; retrying")
+		}
+		blobs := d.newBlobs(referenced)
+		if len(blobs) > 0 {
+			if err := d.ch.insertJSON(ctx, d.db+".context_blobs", blobs); err != nil {
+				for _, b := range blobs {
+					delete(d.blobsWritten, blobKey{b.(contextBlob).Kind, b.(contextBlob).Hash})
+				}
+				return total, fmt.Errorf("insert %d blobs: %w", len(blobs), err)
+			}
+		}
+		if err := d.ch.insertJSON(ctx, d.db+".request_context", rows); err != nil {
+			return total, fmt.Errorf("insert %d context rows (first request_id %s): %w", len(rows), cands[0].RequestID, err)
+		}
+		total += len(cands)
+		last := cands[len(cands)-1]
+		cursorTS, cursorID = last.IngestedAt, last.RequestID
+	}
+	return total, nil
+}
+
+// secretSet reports the redactor's current load and whether it is complete.
+func (d *deriver) secretSet() (uint64, bool) {
+	if len(d.redactor.Failed()) > 0 {
+		return 0, false
+	}
+	return d.redactor.Loads(), true
+}
+
+func (d *deriver) contextWatermark(ctx context.Context) (string, error) {
+	type wm struct {
+		Lower string `json:"lower"`
+		Rows  uint64 `json:"rows"`
+	}
+	var got wm
+	err := selectRows(ctx, d.ch, "SELECT max(ingested_at) - INTERVAL 1 HOUR AS lower, count() AS rows FROM "+d.db+".request_context", nil,
+		func(r wm) { got = r })
+	if err != nil {
+		return "", err
+	}
+	if got.Rows == 0 {
+		return epoch, nil
+	}
+	return got.Lower, nil
+}
+
+// contextCandidates lists the next rows without fetching their bodies.
+func (d *deriver) contextCandidates(ctx context.Context, lower, cursorTS, cursorID string) ([]contextCandidate, error) {
+	q := `SELECT request_id, started_at, ingested_at, length(request_body) AS size,
+    request_headers['x-claude-code-session-id'] AS session_id,
+    request_headers['x-claude-code-agent-id'] AS agent_id
+FROM ` + d.db + `.requests
+WHERE path = '/v1/messages' AND request_body != ''
+  AND ingested_at >= {lower:DateTime64(9, 'UTC')}
+  AND (ingested_at, request_id) > ({cts:DateTime64(9, 'UTC')}, {cid:String})
+  AND request_id NOT IN (
+      SELECT request_id FROM ` + d.db + `.request_context WHERE ingested_at >= {lower:DateTime64(9, 'UTC')})
+ORDER BY ingested_at, request_id
+LIMIT {limit:UInt32}`
+	params := map[string]string{"lower": lower, "cts": cursorTS, "cid": cursorID, "limit": fmt.Sprint(d.batchSize)}
+	var out []contextCandidate
+	err := selectRows(ctx, d.ch, q, params, func(c contextCandidate) { out = append(out, c) })
+	return out, err
+}
+
+// capBytes keeps the longest prefix whose bodies fit in limit, and always at
+// least one row so a single huge body still makes progress.
+func capBytes(cands []contextCandidate, limit uint64) []contextCandidate {
+	var sum uint64
+	for i, c := range cands {
+		sum += c.Size
+		if i > 0 && sum > limit {
+			return cands[:i]
+		}
+	}
+	return cands
+}
+
+// contextBodies fetches whole bodies: ClickHouse's JSON functions rewrite
+// numbers (1e3 → 1000), so tools and system are decoded here, byte for byte.
+func (d *deriver) contextBodies(ctx context.Context, lower string, cands []contextCandidate) (map[string]string, error) {
+	ids := make([]string, len(cands))
+	for i, c := range cands {
+		ids[i] = c.RequestID
+	}
+	type body struct {
+		RequestID string `json:"request_id"`
+		Body      string `json:"request_body"`
+	}
+	out := make(map[string]string, len(cands))
+	err := selectRows(ctx, d.ch, "SELECT request_id, request_body FROM "+d.db+".requests WHERE ingested_at >= {lower:DateTime64(9, 'UTC')} AND request_id IN {ids:Array(String)}",
+		map[string]string{"lower": lower, "ids": chArray(ids)}, func(b body) {
+			if len(b.Body) > len(out[b.RequestID]) {
+				out[b.RequestID] = b.Body
+			}
+		})
+	return out, err
+}
+
+// newBlobs drops blobs this process already wrote or that repeat in the
+// batch. After a restart some are written again; ReplacingMergeTree merges
+// them and every reader groups by (kind, hash).
+func (d *deriver) newBlobs(blobs []contextBlob) []any {
+	// Bounded: forgetting only means a blob is written once more.
+	if len(d.blobsWritten) > maxBlobsWritten {
+		clear(d.blobsWritten)
+	}
+	var out []any
+	for _, b := range blobs {
+		k := blobKey{b.Kind, b.Hash}
+		if !d.blobsWritten[k] {
+			d.blobsWritten[k] = true
+			out = append(out, b)
+		}
+	}
+	return out
+}
+
+type blobKey struct{ kind, hash string }
+
+const maxBlobsWritten = 100_000
+
+// buildContext turns one request into its request_context row and every blob
+// that row references (newBlobs drops those already stored).
+func buildContext(r *redact.Redactor, memo contextMemo, c contextCandidate, body string) (row contextRow, blobs []contextBlob) {
+	row = contextRow{
+		RequestID: c.RequestID, StartedAt: orEpoch(c.StartedAt), IngestedAt: orEpoch(c.IngestedAt),
+		SessionID: c.SessionID, AgentID: c.AgentID, ToolHashes: []string{}, SystemHashes: []string{},
+		Status: contextStatusOK,
+	}
+	fail := func(status string) (contextRow, []contextBlob) {
+		row.ToolHashes, row.SystemHashes, row.Status = []string{}, []string{}, status
+		return row, nil
+	}
+	if body == "" {
+		return fail(contextStatusNoBody)
+	}
+	defer func() {
+		if recover() != nil {
+			row, blobs = fail(contextStatusRedactionFailed)
+		}
+	}()
+	tools, system, ok := splitBody(body)
+	if !ok {
+		return fail(contextStatusUnparseable)
+	}
+	add := func(kind string, raw []byte, build func() (contextBlob, bool)) bool {
+		key := sha256.Sum256(append([]byte(kind+"\x00"), raw...))
+		b, seen := memo[key]
+		if !seen {
+			if b, ok = build(); !ok {
+				return false
+			}
+			memo[key] = b
+		}
+		blobs = append(blobs, b)
+		return true
+	}
+	for _, t := range tools {
+		if !add(kindTool, t, func() (contextBlob, bool) { return toolBlob(r, t) }) {
+			return fail(contextStatusUnparseable)
+		}
+		row.ToolHashes = append(row.ToolHashes, blobs[len(blobs)-1].Hash)
+	}
+	for _, text := range system {
+		kind := kindSystem
+		if strings.HasPrefix(text, billingPrefix) {
+			kind = kindBilling
+		}
+		add(kind, []byte(text), func() (contextBlob, bool) { return textBlob(r, kind, text), true })
+		row.SystemHashes = append(row.SystemHashes, blobs[len(blobs)-1].Hash)
+	}
+	return row, blobs
+}
+
+// splitBody returns the raw tool definitions and the system texts. Absent
+// fields are fine; anything that is not the documented shape is not.
+func splitBody(body string) (tools []json.RawMessage, system []string, ok bool) {
+	var top struct {
+		Tools  json.RawMessage `json:"tools"`
+		System json.RawMessage `json:"system"`
+	}
+	if err := json.Unmarshal([]byte(body), &top); err != nil {
+		return nil, nil, false
+	}
+	if len(top.Tools) > 0 && string(top.Tools) != "null" {
+		if err := json.Unmarshal(top.Tools, &tools); err != nil {
+			return nil, nil, false
+		}
+	}
+	if len(top.System) == 0 || string(top.System) == "null" {
+		return tools, nil, true
+	}
+	var s string
+	if json.Unmarshal(top.System, &s) == nil {
+		if s == "" {
+			return tools, nil, true
+		}
+		return tools, []string{s}, true
+	}
+	var blocks []struct {
+		Text *string `json:"text"`
+	}
+	if err := json.Unmarshal(top.System, &blocks); err != nil {
+		return nil, nil, false
+	}
+	for _, b := range blocks {
+		if b.Text != nil && *b.Text != "" {
+			system = append(system, *b.Text)
+		}
+	}
+	return tools, system, true
+}
+
+// toolBlob redacts every decoded key and string of one tool definition, then
+// stores it as canonical JSON (sorted keys, numbers as sent) without
+// cache_control, which only moves the prompt-cache breakpoint.
+func toolBlob(r *redact.Redactor, raw json.RawMessage) (contextBlob, bool) {
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	dec.UseNumber()
+	var v any
+	if err := dec.Decode(&v); err != nil {
+		return contextBlob{}, false
+	}
+	tool, ok := v.(map[string]any)
+	if !ok {
+		return contextBlob{}, false
+	}
+	delete(tool, "cache_control")
+	// Pattern rules such as generic-api-key need a key next to its value,
+	// so the decoded definition is scanned whole as well as string by string.
+	whole, err := json.Marshal(tool)
+	if err != nil {
+		return contextBlob{}, false
+	}
+	texts := []string{string(whole)}
+	collectStrings(tool, &texts)
+	rep, res := r.NewReplacer(texts), redact.NewResult()
+	clean, _ := redactValue(tool, rep, res).(map[string]any)
+	var buf bytes.Buffer
+	enc := json.NewEncoder(&buf)
+	enc.SetEscapeHTML(false)
+	if err := enc.Encode(clean); err != nil {
+		return contextBlob{}, false
+	}
+	content := strings.TrimSuffix(buf.String(), "\n")
+	name, _ := clean["name"].(string)
+	if name == "" {
+		name, _ = clean["type"].(string)
+	}
+	return contextBlob{Hash: sha256Hex(content), Kind: kindTool, Name: name, Content: content}, true
+}
+
+func textBlob(r *redact.Redactor, kind, text string) contextBlob {
+	clean := r.NewReplacer([]string{text}).Apply(text, redact.NewResult())
+	return contextBlob{Hash: sha256Hex(clean), Kind: kind, Content: clean}
+}
+
+func collectStrings(v any, out *[]string) {
+	switch t := v.(type) {
+	case map[string]any:
+		for k, x := range t {
+			*out = append(*out, k)
+			collectStrings(x, out)
+		}
+	case []any:
+		for _, x := range t {
+			collectStrings(x, out)
+		}
+	case string:
+		*out = append(*out, t)
+	}
+}
+
+func redactValue(v any, rep *redact.Replacer, res *redact.Result) any {
+	switch t := v.(type) {
+	case map[string]any:
+		out := make(map[string]any, len(t))
+		for k, x := range t {
+			out[rep.Apply(k, res)] = redactValue(x, rep, res)
+		}
+		return out
+	case []any:
+		out := make([]any, len(t))
+		for i, x := range t {
+			out[i] = redactValue(x, rep, res)
+		}
+		return out
+	case string:
+		return rep.Apply(t, res)
+	default:
+		return v
+	}
+}
+
+func sha256Hex(s string) string {
+	sum := sha256.Sum256([]byte(s))
+	return hex.EncodeToString(sum[:])
+}
+
+// contextLoopBatches bounds one context pass; the backfill of a full raw
+// window (~6k requests) finishes within a few loops.
+const contextLoopBatches = 20
