@@ -0,0 +1,41 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/api-token/Cli-Proxy-API-Management-Center/plugins/clickhouse-sink/redact"
+)
+
+func TestUsageMetadataAndRewrittenSecretsStayRedacted(t *testing.T) {
+	secret := "sk-known-value-0123456789abcdef"
+	file := filepath.Join(t.TempDir(), "secrets.txt")
+	if err := os.WriteFile(file, []byte(secret+"\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	r, err := redact.New()
+	if err != nil {
+		t.Fatal(err)
+	}
+	r.Configure([]string{file}, nil)
+	// A credential file caught mid-rewrite must not forget what it held.
+	if err := os.WriteFile(file, nil, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	r.Configure([]string{file}, nil)
+
+	row := usageRow{SessionID: "header:" + secret, Source: secret, AuthID: "a-" + secret}
+	redactUsage(r, &row)
+	for _, v := range []string{row.SessionID, row.Source, row.AuthID} {
+		if strings.Contains(v, secret) || !strings.Contains(v, "[REDACTED:known:") {
+			t.Fatalf("usage field not redacted: %q", v)
+		}
+	}
+	req := requestRow{Path: "/v1/messages?key=" + secret, RequestBody: `{"a":"` + secret + `"}`}
+	redactRequest(r, &req)
+	if strings.Contains(req.Path, secret) || strings.Contains(req.RequestBody, secret) {
+		t.Fatalf("request not redacted: %q %q", req.Path, req.RequestBody)
+	}
+}
