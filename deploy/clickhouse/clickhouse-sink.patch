diff --git a/plugins/clickhouse-sink/capture_limit_test.go b/plugins/clickhouse-sink/capture_limit_test.go
new file mode 100644
index 0000000..716f9a8
--- /dev/null
+++ b/plugins/clickhouse-sink/capture_limit_test.go
@@ -0,0 +1,29 @@
+package main
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestCaptureOverLimitKeepsMetadataOnly(t *testing.T) {
+	c := newCapture()
+	now := time.Now()
+	c.begin(interceptRequest{RequestID: "r1", Body: []byte("hello")}, now)
+	chunk := []byte(strings.Repeat("x", 1<<20))
+	for i := 0; i <= maxCaptureBytes>>20; i++ {
+		c.chunk(streamChunkRequest{RequestID: "r1", Body: chunk, ChunkIndex: i}, now)
+	}
+	row := c.complete(completion{RequestID: "r1", Model: "m"})
+	if row.RequestBody != "" || len(row.ResponseChunks) != 0 || !strings.Contains(row.Error, droppedNote) {
+		t.Fatalf("over-limit capture kept bodies: body=%d chunks=%d error=%q", len(row.RequestBody), len(row.ResponseChunks), row.Error)
+	}
+	if c.total != 0 {
+		t.Fatalf("pending bytes not released: %d", c.total)
+	}
+
+	c.begin(interceptRequest{RequestID: "r2", Body: []byte("small")}, now)
+	if row := c.complete(completion{RequestID: "r2"}); row.RequestBody != "small" || row.Error != "" {
+		t.Fatalf("small capture changed: %+v", row)
+	}
+}
