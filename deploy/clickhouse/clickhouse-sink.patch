diff --git a/plugins/clickhouse-sink/redact/detect.go b/plugins/clickhouse-sink/redact/detect.go
new file mode 100644
index 0000000..41b7885
--- /dev/null
+++ b/plugins/clickhouse-sink/redact/detect.go
@@ -0,0 +1,110 @@
+package redact
+
+import (
+	"crypto/sha256"
+	"sync"
+)
+
+// Agents resend the whole conversation on every turn, so a 2 MB request body
+// is mostly text already scanned in earlier requests. Running gitleaks over
+// the whole body is also slow, because nearly every rule's keyword appears
+// somewhere in it and the rule's regex then scans all of it. So text is cut
+// into content-defined segments (boundaries depend only on nearby bytes, so
+// they survive insertions elsewhere), each segment is scanned together with
+// the start of the next one, and findings are cached by the segment's hash.
+const (
+	segMin    = 4 << 10
+	segMax    = 32 << 10
+	segMask   = 8<<10 - 1 // ~8 KiB average segment
+	segWindow = 32
+	// segOverlap is how much of the next segment is scanned with each one:
+	// any secret up to this long that spans a boundary is still found whole.
+	segOverlap = 8 << 10
+	// cacheMax bounds the cache (~ entries × a few findings).
+	cacheMax = 200_000
+)
+
+type finding struct {
+	secret, rule, match string
+}
+
+type segmentCache struct {
+	mu      sync.Mutex
+	entries map[[32]byte][]finding
+}
+
+func (c *segmentCache) get(key [32]byte) ([]finding, bool) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	f, ok := c.entries[key]
+	return f, ok
+}
+
+func (c *segmentCache) put(key [32]byte, f []finding) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.entries == nil || len(c.entries) >= cacheMax {
+		c.entries = make(map[[32]byte][]finding)
+	}
+	c.entries[key] = f
+}
+
+// segments returns content-defined cut points in text: a cut falls where a
+// rolling sum of the last segWindow bytes hits the mask, bounded by segMin
+// and segMax.
+func segments(text string) []int {
+	cuts := []int{0}
+	var sum uint32
+	last := 0
+	for i := 0; i < len(text); i++ {
+		sum = sum*31 + uint32(text[i])
+		if i >= segWindow {
+			sum -= uint32(text[i-segWindow]) * pow31Window
+		}
+		size := i + 1 - last
+		if (size >= segMin && sum&segMask == 0) || size >= segMax {
+			cuts = append(cuts, i+1)
+			last = i + 1
+		}
+	}
+	if last < len(text) {
+		cuts = append(cuts, len(text))
+	}
+	return cuts
+}
+
+// pow31Window is 31^segWindow mod 2^32, to drop the byte leaving the window.
+var pow31Window = func() uint32 {
+	p := uint32(1)
+	for i := 0; i < segWindow; i++ {
+		p *= 31
+	}
+	return p
+}()
+
+// detect returns gitleaks findings in text, scanning segment by segment with
+// overlap and reusing cached results for segments seen before.
+func (r *Redactor) detect(text string) []finding {
+	if r.detector == nil || text == "" {
+		return nil
+	}
+	cuts := segments(text)
+	var out []finding
+	for i := 0; i+1 < len(cuts); i++ {
+		end := cuts[i+1] + segOverlap
+		if end > len(text) {
+			end = len(text)
+		}
+		window := text[cuts[i]:end]
+		key := sha256.Sum256([]byte(window))
+		found, ok := r.cache.get(key)
+		if !ok {
+			for _, f := range r.detector.DetectString(window) {
+				found = append(found, finding{secret: f.Secret, rule: f.RuleID, match: f.Match})
+			}
+			r.cache.put(key, found)
+		}
+		out = append(out, found...)
+	}
+	return out
+}
