diff --git a/plugins/clickhouse-sink/redact_fields_test.go b/plugins/clickhouse-sink/redact_fields_test.go
new file mode 100644
index 0000000..4968d12
--- /dev/null
+++ b/plugins/clickhouse-sink/redact_fields_test.go
@@ -0,0 +1,96 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/api-token/Cli-Proxy-API-Management-Center/plugins/clickhouse-sink/redact"
+)
+
+func TestUsageMetadataAndRewrittenSecretsStayRedacted(t *testing.T) {
+	secret := "sk-known-value-0123456789abcdef"
+	file := filepath.Join(t.TempDir(), "secrets.txt")
+	if err := os.WriteFile(file, []byte(secret+"\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	r, err := redact.New()
+	if err != nil {
+		t.Fatal(err)
+	}
+	r.Configure([]string{file}, nil)
+	// A credential file caught mid-rewrite must not forget what it held.
+	if err := os.WriteFile(file, nil, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	r.Configure([]string{file}, nil)
+
+	row := usageRow{SessionID: "header:" + secret, Source: secret, AuthID: "a-" + secret}
+	redactUsage(r, &row)
+	for _, v := range []string{row.SessionID, row.Source, row.AuthID} {
+		if strings.Contains(v, secret) || !strings.Contains(v, "[REDACTED:known:") {
+			t.Fatalf("usage field not redacted: %q", v)
+		}
+	}
+	req := requestRow{Path: "/v1/messages?key=" + secret, RequestBody: `{"a":"` + secret + `"}`}
+	redactRequest(r, &req)
+	if strings.Contains(req.Path, secret) || strings.Contains(req.RequestBody, secret) {
+		t.Fatalf("request not redacted: %q %q", req.Path, req.RequestBody)
+	}
+}
+
+func TestHalfWrittenCredentialFileIsReportedUntilReadable(t *testing.T) {
+	dir := t.TempDir()
+	auth := filepath.Join(dir, "claude.json")
+	if err := os.WriteFile(auth, []byte(`{"access_token": "tok-abcdef0123456789`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	r, err := redact.New()
+	if err != nil {
+		t.Fatal(err)
+	}
+	r.Configure([]string{dir}, nil)
+	if failed := r.Failed(); len(failed) != 1 || failed[0] != auth {
+		t.Fatalf("Failed() = %v, want the half-written file", failed)
+	}
+	if err := os.WriteFile(auth, []byte(`{"access_token": "tok-abcdef0123456789"}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	r.Configure([]string{dir}, nil)
+	if failed := r.Failed(); len(failed) != 0 {
+		t.Fatalf("Failed() = %v after the file became valid", failed)
+	}
+}
+
+func TestLostEventsMarkInFlightAndOrphanedRows(t *testing.T) {
+	c := newCapture()
+	c.begin(interceptRequest{RequestID: "r1", Body: []byte("{}")}, time.Now())
+	c.markLost()
+	if row := c.complete(completion{RequestID: "r1"}); !strings.Contains(row.Error, lostNote) {
+		t.Fatalf("in-flight row not marked: %q", row.Error)
+	}
+	if row := c.complete(completion{RequestID: "never-began"}); !strings.Contains(row.Error, lostNote) {
+		t.Fatalf("row without a captured request not marked: %q", row.Error)
+	}
+}
+
+func TestMissingSecretSourcesAreReported(t *testing.T) {
+	missing := filepath.Join(t.TempDir(), "auth")
+	r, err := redact.New()
+	if err != nil {
+		t.Fatal(err)
+	}
+	r.Configure([]string{missing}, nil)
+	if failed := r.Failed(); len(failed) != 1 || failed[0] != missing {
+		t.Fatalf("Failed() = %v, want the missing directory", failed)
+	}
+	if err := os.Mkdir(missing, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	r.Configure([]string{missing}, nil)
+	if failed := r.Failed(); len(failed) != 0 {
+		t.Fatalf("Failed() = %v once the directory exists", failed)
+	}
+}
