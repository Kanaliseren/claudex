+	r.Configure([]string{missing}, nil)
+	if failed := r.Failed(); len(failed) != 0 {
+		t.Fatalf("Failed() = %v once the directory exists", failed)
+	}
+}
+
+// RE2 cannot match across invalid UTF-8 where Go's regexp can, so text is
+// normalized first; this token is followed by a stray 0xff byte.
+func TestSecretBeforeInvalidUTF8IsRedacted(t *testing.T) {
+	r, err := redact.New()
+	if err != nil {
+		t.Fatal(err)
+	}
+	r.Configure(nil, nil)
+	token := "sha256~" + "Zk3Q9mW2xV7pL4tR8nB1cH6jD5fG0sA2eY9uKp3Lq7R"
+	row := requestRow{RequestBody: "token " + token + "\xff rest", ResponseChunks: []string{"data: " + token + "\xff"}}
+	redactRequest(r, &row)
+	if strings.Contains(row.RequestBody, token) || strings.Contains(row.ResponseChunks[0], token) {
+		t.Fatalf("token survived: %q / %q", row.RequestBody, row.ResponseChunks[0])
+	}
+}
+
+func TestNormalizationMatchesJSONEncoding(t *testing.T) {
+	for _, in := range []string{"a\xff\xffb", "\xe2\x82", "ok \xc3\x28 \xf0\x9f\x98", "plain", ""} {
+		// What ClickHouse stores is the decoded JSON string.
+		raw, _ := json.Marshal(in)
+		var stored string
+		_ = json.Unmarshal(raw, &stored)
+		if got := validUTF8(in); got != stored {
+			t.Fatalf("%q: normalized %q, stored %q", in, got, stored)
+		}
+	}
+}
