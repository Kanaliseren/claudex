{
  "name": "claudex",
  "version": "0.7.1",
  "description": "Run Claude Code through your local Codex OAuth session via CLIProxyAPI",
  "type": "module",
  "bin": {
    "claudex": "bin/claudex.js",
    "cliproxy-oauth": "bin/claudex.js"
  },
  "files": [
    "bin",
    "channel",
    "docs",
    "scripts",
    "src",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check bin/claudex.js && node --test && npm pack --dry-run",
    "check:upstreams": "node scripts/check-upstreams.mjs",
    "promote:proxy": "node scripts/promote-proxy.mjs",
    "verify:assets": "node scripts/verify-stable-assets.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kanaliseren/claudex.git"
  },
  "bugs": {
    "url": "https://github.com/Kanaliseren/claudex/issues"
  },
  "homepage": "https://github.com/Kanaliseren/claudex#readme",
  "keywords": [
    "claude-code",
    "cliproxyapi",
    "codex",
    "oauth",
    "paseo",
    "t3-code"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
